<% layout("layouts/boilerplate.ejs")-%>

    <body>
        <div class="row mt-3 justify-content-center">
            <!-- Card Column: 100% width on phone, 80% on tablet/iPad, 60% on desktop -->
            <div class="col-12 col-md-10 col-lg-8">
                <div class="card offset-2 show-card">
                    <h1 class="fw-bold mb-3 text-break"><b>
                            <%=list.title%>
                        </b></h1>
                    <!-- Listing Card -->
                    <div class="card show-card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                        <img src="<%=list.image.url%>" class="card-img-top show-image img-fluid" alt="listing image"
                            style="max-height: 400px; object-fit: cover;">
                        <div class="card-body px-3 px-md-4 py-3">
                            <p class="card-text text-secondary mb-2">Owned By: <i>
                                    <%=list.owner.username%>
                                </i></p>
                            <p class="card-text mb-2">
                                <%=list.description%><br>
                            </p>
                            <p class="card-text fw-bold fs-5 text-dark mb-2">
                                &#8377;<%=list.price.toLocaleString("en-IN")%><span
                                        class="fs-6 text-muted fw-normal"></span><br></p>
                            <p class="card-text text-muted mb-0">
                                <i class="fa-solid fa-location-dot me-1"></i>
                                <%=list.location%>, <%=list.country%>
                            </p>

                        </div>

                    </div>
                    <!-- Edit / Delete Action Buttons -->
                    <% if(currUser && currUser._id.equals(list.owner._id)) { %>
                        <!-- Buttons block: Auto-width on desktop, full-width on mobile -->
                        <div class="d-flex flex-wrap gap-2 gap-sm-3 my-3">
                            <!-- Edit Button -->
                            <a href="/Listings/<%= list._id %>/edit"
                                class="btn btn-dark px-4 py-2 rounded-3 flex-fill flex-sm-grow-0 fw-semibold">
                                Edit
                            </a>

                            <!-- Delete Form & Button -->
                            <form method="POST" action="/Listings/<%= list._id %>?_method=DELETE"
                                class="m-0 flex-fill flex-sm-grow-0">
                                <button type="submit"
                                    class="btn btn-outline-danger px-4 py-2 rounded-3 w-100 fw-semibold">
                                    Delete
                                </button>
                            </form>
                        </div>
                        <% } %>

                </div>

                <!-- Reviews Section Container -->
                <div class="col-12 col-md-10 col-lg-8 mx-auto mt-3">
                    <hr class="my-4 opacity-25">

                    <% if(currUser) { %>
                        <h4 class="fw-bold mb-3">Leave a Review</h4>

                        <form method="POST" action="/Listings/<%=list._id%>/reviews" novalidate
                            class="needs-validation mb-4">

                            <!-- Rating Starability Widget -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="rating">Rating</label>
                                <fieldset class="starability-coinFlip d-block">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="reviews[rating]"
                                        value="1" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="reviews[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="reviews[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="reviews[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="reviews[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="reviews[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>

                            <!-- Comment Textarea -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-capitalize" for="comment">Comment</label>
                                <textarea class="form-control rounded-3" name="reviews[comment]" id="comment" rows="4"
                                    required placeholder="Share details of your stay..."></textarea>
                                <div class="invalid-feedback">
                                    Please leave a comment before submitting!
                                </div>
                            </div>

                            <!-- Explicitly cap button width so it never stretches across desktop columns -->
                            <button type="submit" class="btn btn-dark px-4 py-2 mt-3 rounded-3 fw-semibold"
                                style="width: auto; max-width: 180px;">
                                Submit Review
                            </button>
                        </form>

                        <hr class="my-4 opacity-25">
                        <% } %>

                            <!-- Existing Reviews Grid -->
                            <% if(list.reviews && list.reviews.length> 0) { %>
                                <h4 class="fw-bold mb-3">All Reviews</h4>

                                <!-- Grid: 1 column on phones (col-12), 2 columns on tablets/iPad (col-sm-6) -->
                                <div class="row g-3 mb-4">
                                    <% for(let review of list.reviews) { %>
                                        <div class="col-12 col-sm-6">
                                            <div class="card h-100 border shadow-sm rounded-3 p-3">
                                                <div class="card-body p-0 d-flex flex-column justify-content-between">
                                                    <div>
                                                        <h6 class="card-title fw-bold mb-1">@<%= review.author.username
                                                                %>
                                                        </h6>
                                                        <p class="starability-result card-text mb-2"
                                                            data-rating="<%= review.rating %>"></p>
                                                        <p class="card-text text-secondary mb-3 small">
                                                            <%= review.comment %>
                                                        </p>
                                                    </div>

                                                    <% if(currUser && currUser._id.equals(review.author._id)) { %>
                                                        <form method="POST"
                                                            action="/Listings/<%=list._id%>/reviews/<%=review._id%>?_method=DELETE"
                                                            class="delete-form mt-auto">
                                                            <button
                                                                class="btn btn-sm btn-outline-danger rounded-2">Delete</button>
                                                        </form>
                                                        <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>
                                <% } %>
                </div>


            </div>
        </div>



    </body>