<%-layout("layouts/boilerplate.ejs") %>

    <body>
        <div class="row justify-content-center my-4 px-2">
            <!-- Responsive Column: Full width on mobile, centered on medium+ screens -->
            <div class="col-12 col-md-8 col-lg-6">
                <h2 class="fw-bold mb-4 text-center text-md-start">Edit Details</h2>

                <form method="POST" action="/Listings/<%= list._id %>?_method=PUT" novalidate class="needs-validation"
                    enctype="multipart/form-data">

                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">Title</label>
                        <input type="text" value="<%= list.title %>" name="listing[title]" id="title"
                            class="form-control rounded-3" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter a title.</div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea name="listing[description]" id="description" rows="4" class="form-control rounded-3"
                            required><%= list.description %></textarea>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter a short description.</div>
                    </div>

                    <!-- Original Image Preview (Responsive) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Original Image</label>
                        <div class="img-preview-wrapper overflow-hidden rounded-3 border"
                            style="max-width: 300px; height: 200px;">
                            <img src="<%= originalImageUrl %>" alt="Original Listing Image"
                                class="w-100 h-100 object-fit-cover">
                        </div>
                    </div>

                    <!-- File Upload for New Image -->
                    <div class="mb-3">
                        <label for="image" class="form-label fw-semibold">Upload New Image (Optional)</label>
                        <input type="file" name="listing[image]" id="image" class="form-control rounded-3">
                    </div>

                    <!-- Price & Category -->
                    <div class="row">
                        <div class="mb-3 col-12 col-md-6">
                            <label for="price" class="form-label fw-semibold">Price (per night)</label>
                            <input type="number" min="0" value="<%= list.price %>" name="listing[price]" id="price"
                                class="form-control rounded-3" required>
                            <div class="invalid-feedback">Please enter a valid price.</div>
                        </div>

                        <div class="mb-3 col-12 col-md-6">
                            <label for="category" class="form-label fw-semibold">Category</label>
                            <select name="listing[category]" id="category" class="form-select rounded-3" required>
                                <option value="Trending" <%=list.category==='Trending' ? 'selected' : '' %>>Trending
                                </option>
                                <option value="Mountains" <%=list.category==='Mountains' ? 'selected' : '' %>>Mountains
                                </option>
                                <option value="Castles" <%=list.category==='Castles' ? 'selected' : '' %>>Castles
                                </option>
                                <option value="Pool" <%=list.category==='Pool' ? 'selected' : '' %>>Pool</option>
                                <option value="Beach" <%=list.category==='Beach' ? 'selected' : '' %>>Beach</option>
                                <option value="Gym" <%=list.category==='Gym' ? 'selected' : '' %>>Gym</option>
                            </select>
                            <div class="invalid-feedback">Please select a category.</div>
                        </div>
                    </div>

                    <!-- Location & Country -->
                    <div class="row">
                        <div class="mb-3 col-12 col-md-6">
                            <label for="location" class="form-label fw-semibold">Location</label>
                            <input type="text" value="<%= list.location %>" name="listing[location]" id="location"
                                class="form-control rounded-3" required>
                            <div class="invalid-feedback">Please enter a location.</div>
                        </div>

                        <div class="mb-3 col-12 col-md-6">
                            <label for="country" class="form-label fw-semibold">Country</label>
                            <input type="text" value="<%= list.country %>" name="listing[country]" id="country"
                                class="form-control rounded-3" required>
                            <div class="invalid-feedback">Please enter a country.</div>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button class="btn btn-dark w-100 w-sm-auto px-4 py-2 mt-3 rounded-3 fw-semibold edit-btn">
                        Update
                    </button>
                </form>
            </div>
        </div>

    </body>